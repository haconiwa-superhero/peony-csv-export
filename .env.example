# Shopify Partners App の Client ID
SHOPIFY_CLIENT_ID=ebfadca3f9c7e65a3f642ef325f24da6

# Shopify Partners App の Client Secret（本番では絶対に公開しないこと）
SHOPIFY_CLIENT_SECRET=your_client_secret_here

# デプロイ先のURL（RenderのURL）
HOST=https://your-app.onrender.com

# ストアドメイン
SHOPIFY_SHOP=haconiwa-test-shop.myshopify.com

# 初回インストール後に取得するアクセストークン
SHOPIFY_ACCESS_TOKEN=

# 在庫通知（ステージングでは必ず POUCH_SYNC_ENABLED=false / DRY_RUN=true）
POUCH_SYNC_ENABLED=true
INVENTORY_ALERTS_ENABLED=false
INVENTORY_ALERTS_DRY_RUN=true
REGISTER_WEBHOOKS_ENABLED=true
INVENTORY_ALERT_THRESHOLDS=500,300,100,50,0
INVENTORY_ALERT_RECIPIENT=admin@ivycorp.org
INVENTORY_ALERT_DEBOUNCE_MS=30000
INVENTORY_ALERT_STATE_FILE=./data/inventory-alert-state.json

# 本番メール送信を有効にする場合のみ設定
RESEND_API_KEY=
INVENTORY_ALERT_FROM=
